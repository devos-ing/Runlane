  "cards": [
    {
      "dot": "cyan",
      "title": "Parent owns the entry point",
      "items": [
        "run checks Runtime identity and cancellation before and after native work.",
        "Subclasses implement validate(request, signal) and execute(request, context)."
      ]
    },
    {
      "dot": "emerald",
      "title": "Subclasses own native work",
      "items": [
        "Translate events, enforce supported settings, and clean up in finally.",
        "Conversation state belongs to each attempt, not a shared current-session field."
      ]
    },
    {
      "dot": "amber",
      "title": "Composition stays explicit",
      "items": [
        "The Runner validates output and commits routes. Runtime has no store access.",
        "Script Actions execute directly and do not inherit Runtime."
      ]
    }
  ]
