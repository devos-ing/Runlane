      "toSide": "right",
      "via": [
        [
          500,
          185
        ],
        [
          365,
          185
        ],
        [
          365,
          243
        ]
      ]
    },
    {
      "id": "review-repair",
      "from": "parallel-review",
      "to": "repair-budget",
      "label": "changes requested",
      "role": "branch",
      "variant": "dashed",
      "labelDy": 40
    },
    {
      "id": "repair-loop",
      "from": "repair-budget",
      "to": "implement",
      "label": "allowance remains",
      "role": "return",
      "variant": "emphasis"
    },
    {
      "id": "repair-exhausted",
      "from": "repair-budget",
      "to": "needs-input",
