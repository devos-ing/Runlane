  "cards": [
    {
      "dot": "cyan",
      "title": "Two kinds of parallel work",
      "items": [
        "Reviewer A and B run independently against one immutable candidate.",
        "Separate workflow runs can also execute across different workspaces."
      ]
    },
    {
      "dot": "amber",
      "title": "The loop really returns",
      "items": [
        "Checks and review share two repairs after the initial implementation.",
        "Each repair reruns checks and every reviewer. Persist the counter before dispatch."
      ]
    },
    {
      "dot": "rose",
      "title": "Failure is not rejection",
      "items": [
        "Malformed results and execution errors stop advancement; they do not enter repair automatically.",
        "Valid needs_input from a step or an exhausted budget stops automatic work."
      ]
    }
  ]
